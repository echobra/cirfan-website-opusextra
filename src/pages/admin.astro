---
// src/pages/admin.astro
// Private dashboard at /admin. middleware.ts asks for ADMIN_USERNAME and ADMIN_PASSWORD before this page loads.
// Create a client page, share its link, upload deliverables (metadata is removed on upload), and read the
// activity log. All logic is in src/scripts/admin.ts.
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Dashboard | cirfan" label="Dashboard">
  <div class="wrap admin">
    <aside class="side" aria-label="Client pages">
      <div class="side__head">
        <h1 class="side__title">Client pages</h1>
        <button class="btn btn--primary btn--small" type="button" data-new-client>New page</button>
      </div>
      <button class="btn btn--outline btn--small side__bulk" type="button" data-bulk-open>Bulk upload for several clients</button>
      <label class="visually-hidden" for="client-search">Search client pages</label>
      <input class="input" id="client-search" type="search" placeholder="Search" autocomplete="off" data-search />
      <ul class="client-list" data-client-list></ul>
      <p class="small-print" data-list-empty hidden>No client pages yet. Create one to get a link.</p>
      <p class="error" data-list-error hidden></p>
    </aside>

    <section class="main" aria-live="polite">
      <div class="bulk" data-bulk hidden>
        <header class="bulk__head">
          <div>
            <h2 class="bulk__title">Bulk upload</h2>
            <p class="lede">
              Drop folders for several clients at once. Each top folder goes to the client page with the same name, and
              each folder inside it becomes a folder on that page.
            </p>
          </div>
          <button class="btn btn--outline btn--small" type="button" data-bulk-close>Close</button>
        </header>

        <label class="drop" data-bulk-drop>
          <span class="drop__main">Drop client folders here</span>
          <span class="drop__hint">Or drop the folder that holds them. Nothing is sent until you review the plan.</span>
          <pre class="bulk__tree" aria-label="Example folder layout">cirfan-client-work/
  acme corp/          goes to the page “Acme Corp”
    oct01-31/         becomes a folder on that page
      cinematic-v1.mp4
  mediacrater/
    oct01-31/
      video1.mp4</pre>
        </label>
        <div class="upload__options">
          <button class="btn btn--outline btn--small" type="button" data-bulk-pick>Choose a folder</button>
          <input type="file" webkitdirectory multiple hidden data-bulk-input />
        </div>

        <div class="bulk__plan" data-bulk-plan hidden>
          <h3 class="block__title">Review before uploading</h3>
          <p class="small-print" data-bulk-note></p>
          <div class="table-wrap">
            <table class="log plan">
              <thead><tr><th scope="col">Folder</th><th scope="col">Client page</th><th scope="col">What will be uploaded</th></tr></thead>
              <tbody data-bulk-rows></tbody>
            </table>
          </div>
          <label class="check"><input type="checkbox" data-bulk-skip-existing checked /> Skip files already on the page (safe to re-run after a failure)</label>
          <label class="check"><input type="checkbox" data-bulk-email checked /> Email each client when their files are ready</label>
          <p class="small-print">
            Emails only go to clients with email updates on who have created their password and opened their page.
            Keep this tab open until it finishes: files upload from this computer.
          </p>
          <p class="bulk__summary" data-bulk-summary></p>
          <div class="upload__options">
            <button class="btn btn--primary btn--small" type="button" data-bulk-start>Start upload</button>
            <button class="btn btn--outline btn--small" type="button" data-bulk-cancel>Clear</button>
          </div>
        </div>

        <div class="bulk__run" data-bulk-run hidden>
          <h3 class="block__title">Uploading</h3>
          <ul class="bulk__progress" data-bulk-progress></ul>
        </div>
      </div>

      <div class="empty" data-detail-empty>
        <p class="lede">Pick a client page, or create one. Each page gets its own private link and acts as that client’s folder.</p>
      </div>

      <div class="detail" data-detail hidden>
        <header class="detail__head">
          <div>
            <h2 class="detail__name" data-field="name"></h2>
            <p class="detail__contact" data-field="contact"></p>
          </div>
          <div class="detail__actions">
            <button class="btn btn--outline btn--small" type="button" data-edit>Edit</button>
            <button class="btn btn--outline btn--small" type="button" data-reset>Reset password</button>
            <button class="btn btn--outline btn--small" type="button" data-end-sessions>Sign out all browsers</button>
            <button class="btn btn--outline btn--small btn--danger" type="button" data-delete>Delete page</button>
          </div>
        </header>

        <div class="link-row">
          <code class="link-row__url" data-field="link"></code>
          <button class="btn btn--primary btn--small" type="button" data-copy-link>Copy link</button>
          <a class="link" href="#" target="_blank" rel="noopener" data-open-link>Open</a>
        </div>

        <dl class="facts">
          <div><dt>Password</dt><dd data-field="password"></dd></div>
          <div><dt>Files</dt><dd data-field="files"></dd></div>
          <div><dt>Last client activity</dt><dd data-field="activity"></dd></div>
          <div><dt>Created</dt><dd data-field="created"></dd></div>
          <div><dt>Email updates</dt><dd data-field="notify"></dd></div>
        </dl>

        <section class="block" aria-labelledby="files-title">
          <div class="block__head">
            <h3 id="files-title" class="block__title">Files</h3>
            <div class="block__tools">
              <button class="btn btn--outline btn--small" type="button" data-new-folder>New folder</button>
            </div>
          </div>

          <nav class="tabs" aria-label="Folders" data-tabs></nav>

          <div class="folder-bar" data-folder-bar hidden>
            <p class="folder-bar__name" data-folder-name></p>
            <div class="folder-bar__actions">
              <button class="btn btn--outline btn--small" type="button" data-folder-rename>Rename</button>
              <button class="btn btn--outline btn--small" type="button" data-folder-archive>Archive</button>
              <button class="btn btn--outline btn--small btn--danger" type="button" data-folder-delete>Delete folder</button>
            </div>
          </div>

          <div class="upload" data-upload>
            <label class="drop" data-drop>
              <input type="file" multiple accept=".mp4,.m4v,.mov,.webm,.jpg,.jpeg,.png,.webp" data-file-input />
              <span class="drop__main">Drop files or whole folders here, or click to choose files</span>
              <span class="drop__hint" data-drop-target></span>
              <span class="drop__hint">MP4, MOV, WebM, JPG, PNG or WebP, up to 200 MB each. Metadata is removed, and videos the browser can’t play (HEVC, ProRes, 10-bit, HDR) are converted to H.264.</span>
            </label>
            <div class="upload__options">
              <button class="btn btn--outline btn--small" type="button" data-pick-folder>Upload a folder</button>
              <input type="file" webkitdirectory multiple hidden data-folder-input />
              <label class="check"><input type="checkbox" data-notify checked /> Email the client when this upload finishes</label>
              <span class="small-print" data-notify-state></span>
            </div>
          </div>
          <p class="small-print" data-archive-note hidden>Archived folders and files stay visible to the client under their Archive tab. Open a folder to restore it.</p>

          <ul class="queue" data-queue></ul>
          <ul class="folder-grid" data-folder-grid></ul>
          <ul class="file-grid" data-file-grid></ul>
          <p class="small-print" data-files-empty hidden>Nothing here yet.</p>
        </section>

        <section class="block" aria-labelledby="log-title">
          <div class="block__head">
            <h3 id="log-title" class="block__title">Activity</h3>
            <div class="block__tools">
              <label class="visually-hidden" for="log-filter">Filter activity</label>
              <select class="input input--small" id="log-filter" data-log-filter>
                <option value="all">Everything</option>
                <option value="client">Client actions</option>
                <option value="auth">Sign-ins</option>
                <option value="downloads">Downloads</option>
                <option value="admin">Admin and system</option>
              </select>
              <button class="btn btn--outline btn--small" type="button" data-csv>Download CSV</button>
            </div>
          </div>
          <div class="table-wrap">
            <table class="log">
              <thead>
                <tr><th scope="col">Time</th><th scope="col">Who</th><th scope="col">What</th><th scope="col">Details</th><th scope="col">IP</th><th scope="col">Device</th></tr>
              </thead>
              <tbody data-log></tbody>
            </table>
          </div>
          <p class="small-print" data-log-empty hidden>Nothing logged yet.</p>
        </section>
      </div>
    </section>
  </div>

  <dialog class="dialog" data-client-dialog aria-labelledby="client-dialog-title">
    <form method="dialog" class="dialog__form" data-client-form>
      <h2 id="client-dialog-title" class="dialog__title" data-dialog-title>New client page</h2>
      <label class="field">
        <span class="field__label">Client or brand name</span>
        <input class="input" name="name" maxlength="120" required />
      </label>
      <fieldset class="field">
        <legend class="field__label">Communication</legend>
        <div class="radio-row">
          <label class="radio"><input type="radio" name="contactMethod" value="email" checked /> Email</label>
          <label class="radio"><input type="radio" name="contactMethod" value="slack" /> Private Slack channel</label>
        </div>
      </fieldset>
      <label class="field">
        <span class="field__label">Email address or Slack channel name</span>
        <input class="input" name="contactDetail" maxlength="200" />
      </label>
      <label class="field">
        <span class="field__label">Email for upload notifications</span>
        <input class="input" name="notifyEmail" type="email" maxlength="254" placeholder="Same as above if they chose email" />
      </label>
      <label class="radio"><input type="checkbox" name="notifyEnabled" checked /> Email the client when new files are added</label>
      <p class="error" data-dialog-error hidden></p>
      <div class="dialog__actions">
        <button class="btn btn--outline btn--small" type="button" value="cancel" data-dialog-cancel>Cancel</button>
        <button class="btn btn--primary btn--small" type="submit" value="save">Save</button>
      </div>
    </form>
  </dialog>

  <dialog class="dialog" data-confirm-dialog aria-labelledby="confirm-title">
    <form method="dialog" class="dialog__form" data-confirm-form>
      <h2 id="confirm-title" class="dialog__title" data-confirm-title></h2>
      <p data-confirm-text></p>
      <label class="field" data-confirm-type-wrap hidden>
        <span class="field__label" data-confirm-type-label></span>
        <input class="input" data-confirm-type autocomplete="off" />
      </label>
      <div class="dialog__actions">
        <button class="btn btn--outline btn--small" type="button" data-confirm-cancel>Cancel</button>
        <button class="btn btn--primary btn--small" type="submit" data-confirm-ok>Confirm</button>
      </div>
    </form>
  </dialog>

  <template id="tpl-client">
    <li><button class="client" type="button"><span class="client__name"></span><span class="client__meta"></span></button></li>
  </template>
  <template id="tpl-file">
    <li class="file">
      <div class="file__preview"></div>
      <p class="file__name"></p>
      <p class="file__meta"></p>
      <label class="file__move"><span class="visually-hidden">Move to folder</span><select class="input input--small" data-move></select></label>
      <div class="file__actions">
        <button class="btn btn--outline btn--small" type="button" data-archive>Archive</button>
        <button class="btn btn--outline btn--small btn--danger" type="button" data-remove>Remove</button>
      </div>
    </li>
  </template>
  <template id="tpl-folder">
    <li><button class="folder-card" type="button"><span class="folder-card__icon" aria-hidden="true"></span><span class="folder-card__name"></span><span class="folder-card__meta"></span></button></li>
  </template>
  <template id="tpl-queue">
    <li class="queue__item"><span class="queue__name"></span><span class="queue__status"></span><span class="queue__bar"><span></span></span></li>
  </template>
</AppLayout>

<script>
  import '../scripts/admin';
</script>

<style>
  .admin {
    display: grid;
    grid-template-columns: minmax(15rem, 19rem) minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-7) var(--space-9);
    align-items: start;
  }

  .side {
    position: sticky;
    top: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }
  .side__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .side__title {
    font-size: var(--fs-xl);
  }
  .side__head .btn {
    white-space: nowrap;
  }
  .side__bulk {
    width: 100%;
  }

  .bulk {
    display: grid;
    gap: var(--space-5);
  }
  .bulk__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .bulk__title {
    font-size: var(--fs-2xl);
  }
  .bulk__head .lede {
    margin-top: var(--space-3);
    max-width: 44rem;
  }
  .bulk__tree {
    margin: var(--space-3) auto 0;
    padding: var(--space-4);
    border-radius: var(--radius-s);
    background: var(--bg-sunk);
    color: var(--ink-2);
    font-size: var(--fs-xs);
    line-height: 1.6;
    text-align: left;
    overflow-x: auto;
  }
  .bulk__plan,
  .bulk__run {
    display: grid;
    gap: var(--space-4);
  }
  .bulk__summary {
    font-weight: 500;
  }
  .plan :global(select) {
    max-width: 18rem;
  }
  .plan :global(tr.is-skipped td) {
    color: var(--ink-3);
  }
  .bulk__progress {
    display: grid;
    gap: var(--space-4);
    list-style: none;
  }
  .bulk__progress :global(.bulk-client) {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    background: var(--bg-raised);
  }
  .bulk__progress :global(.bulk-client--done) {
    border-color: var(--mark);
    font-weight: 500;
  }
  .bulk__progress :global(.bulk-client__head) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }
  .bulk__progress :global(.bulk-client__head span) {
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .bulk__progress :global(.bulk-client__head span.is-error) {
    color: var(--mark);
  }
  .bulk__progress :global(summary) {
    font-size: var(--fs-sm);
    cursor: pointer;
  }

  .input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    background: var(--bg-raised);
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-sm);
  }
  .input--small {
    width: auto;
    min-height: 2.5rem;
  }

  .client-list {
    display: grid;
    gap: 2px;
    list-style: none;
    max-height: 70vh;
    overflow-y: auto;
  }
  .client-list :global(.client) {
    display: grid;
    gap: 0.1rem;
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 0;
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius-s) var(--radius-s) 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }
  .client-list :global(.client:hover) {
    background: var(--bg-raised);
  }
  .client-list :global(.client[aria-current='true']) {
    border-left-color: var(--mark);
    background: var(--bg-raised);
  }
  .client-list :global(.client__name) {
    font-weight: 500;
  }
  .client-list :global(.client__meta) {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }

  .error {
    font-size: var(--fs-sm);
    color: var(--mark);
  }

  .empty {
    padding: var(--space-8) 0;
    max-width: 36rem;
  }

  .detail {
    display: grid;
    gap: var(--space-6);
  }
  .detail__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .detail__name {
    font-size: var(--fs-2xl);
  }
  .detail__contact {
    margin-top: var(--space-2);
    color: var(--ink-2);
  }
  .detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: flex-start;
  }
  :global(.btn--danger:hover) {
    border-color: var(--mark);
    color: var(--mark);
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    background: var(--bg-raised);
  }
  .link-row__url {
    flex: 1 1 18rem;
    overflow-wrap: anywhere;
    font-size: var(--fs-sm);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-4);
  }
  .facts dt {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .facts dd {
    margin: 0.15rem 0 0;
    font-weight: 500;
  }

  .block {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .block__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .block__tools {
    display: flex;
    gap: var(--space-2);
  }
  .block__title {
    font-size: var(--fs-xl);
  }

  .drop {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-m);
    text-align: center;
    cursor: pointer;
    transition:
      border-color 0.2s var(--ease-out),
      background-color 0.2s var(--ease-out);
  }
  .drop:hover,
  .drop:global(.is-over) {
    border-color: var(--mark);
    background: var(--bg-raised);
  }
  .drop input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .drop:has(input:focus-visible) {
    outline: 2px solid var(--mark);
    outline-offset: 3px;
  }
  .drop__main {
    font-weight: 500;
  }
  .drop__hint {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tabs :global(.tab) {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    font-size: var(--fs-xs);
    font-weight: 500;
    cursor: pointer;
  }
  .tabs :global(.tab[aria-pressed='true']) {
    background: var(--btn-bg);
    border-color: var(--btn-bg);
    color: var(--btn-ink);
  }
  .folder-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .folder-bar__name {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
  }
  .folder-bar__actions,
  .upload__options {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .upload {
    display: grid;
    gap: var(--space-3);
  }
  .check {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-sm);
  }
  .folder-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-3);
    list-style: none;
  }
  .folder-grid:empty {
    display: none;
  }
  .folder-grid :global(.folder-card) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-3);
    width: 100%;
    padding: var(--space-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    background: var(--bg-raised);
    text-align: left;
    cursor: pointer;
  }
  .folder-grid :global(.folder-card:hover) {
    border-color: var(--ink);
  }
  .folder-grid :global(.folder-card__icon) {
    grid-row: span 2;
    width: 1.6rem;
    height: 1.25rem;
    margin-top: 0.2rem;
    border: 1.5px solid var(--mark);
    border-radius: 2px 2px 3px 3px;
    position: relative;
  }
  .folder-grid :global(.folder-card__icon::before) {
    content: '';
    position: absolute;
    left: -1.5px;
    top: -0.4rem;
    width: 0.7rem;
    height: 0.35rem;
    border: 1.5px solid var(--mark);
    border-bottom: 0;
    border-radius: 2px 2px 0 0;
  }
  .folder-grid :global(.folder-card__name) {
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .folder-grid :global(.folder-card__meta) {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .file-grid :global(.file__actions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .file-grid :global(.file__move .input) {
    width: 100%;
  }

  .queue {
    display: grid;
    gap: var(--space-2);
    list-style: none;
  }
  .queue :global(.queue__item) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.25rem var(--space-4);
    font-size: var(--fs-sm);
  }
  .queue :global(.queue__name) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .queue :global(.queue__status) {
    color: var(--ink-3);
  }
  .queue :global(.queue__status.is-error) {
    color: var(--mark);
  }
  .queue :global(.queue__bar) {
    grid-column: 1 / -1;
    height: 2px;
    background: var(--line);
  }
  .queue :global(.queue__bar span) {
    display: block;
    height: 100%;
    background: var(--mark);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s linear;
  }

  .file-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-5);
    list-style: none;
  }
  .file-grid :global(.file) {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }
  .file-grid :global(.file__preview video),
  .file-grid :global(.file__preview img) {
    width: 100%;
