---
// src/components/WorkItem.astro
// One portfolio piece. Data comes from src/data/portfolio.ts.
// variant="feature": wide alternating row (home page). variant="card": grid card (/work).
import Player from './Player.astro';
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  item: PortfolioItem;
  variant?: 'feature' | 'card';
  flip?: boolean;
  headingLevel?: 'h3' | 'h2';
}

const { item, variant = 'card', flip = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const label = `${item.title}, ${item.style} demo ad by cirfan`;
---

<article class:list={['work-item', `work-item--${variant}`, { 'work-item--flip': flip }]} id={item.slug}>
  <div class="work-item__media">
    {
      item.media.kind === 'video' ? (
        <Player media={item.media} title={item.title} label={label} variant="card" />
      ) : (
        <img
          class="work-item__image"
          src={item.media.src}
          width={item.media.width}
          height={item.media.height}
          alt={label}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>

  <div class="work-item__text">
    <p class="work-item__style">{item.style}</p>
    <Heading class="work-item__title">{item.title}</Heading>
    <p class="work-item__summary">{item.summary}</p>
    <ul class="work-item__bullets">
      {item.bullets.map((b) => <li>{b}</li>)}
    </ul>
    {item.note && <p class="work-item__note small-print">{item.note}</p>}
  </div>
</article>

<style>
  .work-item {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  .work-item--feature {
    grid-template-columns: minmax(14rem, 22rem) minmax(0, 1fr);
    gap: var(--space-6) clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .work-item--feature.work-item--flip {
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 22rem);
  }
  .work-item--feature.work-item--flip .work-item__media {
    order: 2;
  }
  .work-item--feature.work-item--flip .work-item__text {
    justify-self: end;
  }

  .work-item__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-m);
    box-shadow: 0 0 0 1px var(--line);
  }

  .work-item__text {
    display: grid;
    gap: var(--space-4);
    max-width: 34rem;
  }

  .work-item__style {
    justify-self: start;
    padding: 0.15rem 0.6rem 0.2rem;
    border: 1px solid var(--mark);
    border-radius: 999px;
    color: var(--mark);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.4;
  }

  .work-item__title {
    font-size: var(--fs-2xl);
  }
  .work-item--card .work-item__title {
    font-size: var(--fs-xl);
  }

  .work-item__summary {
    font-size: var(--fs-lg);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .work-item--card .work-item__summary {
    font-size: var(--fs-base);
  }

  .work-item__bullets {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin-top: var(--space-2);
  }
  .work-item__bullets li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--ink-2);
    line-height: 1.55;
  }
  /* A short vertical tick, like a mark on a tape measure. */
  .work-item__bullets li::before {
    content: '';
    position: absolute;
    left: 0.3rem;
    top: 0.45em;
    width: 1px;
    height: 0.75em;
    background: var(--mark);
  }
  .work-item--card .work-item__bullets li {
    font-size: var(--fs-sm);
  }

  .work-item__note {
    margin-top: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 52rem) {
    .work-item--feature,
    .work-item--feature.work-item--flip {
      grid-template-columns: minmax(0, 1fr);
    }
    .work-item--feature .work-item__media,
    .work-item--feature.work-item--flip .work-item__media {
      order: 0;
      max-width: 22rem;
    }
    .work-item--feature.work-item--flip .work-item__text {
      justify-self: start;
    }
  }
</style>
