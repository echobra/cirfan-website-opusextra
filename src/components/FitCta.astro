---
// src/components/FitCta.astro
// The main call to action: the questionnaire button with its small note underneath.
// Text and link live in src/config/site.ts (fitCta).
import { fitCta } from '../config/site';

interface Props {
  small?: boolean;
}

const { small = false } = Astro.props;
const noteId = `fit-note-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="fit-cta">
  <a class:list={['btn btn--primary', { 'btn--small': small }]} href={fitCta.href} aria-describedby={noteId}>
    {fitCta.label}
  </a>
  <span class="fit-cta__note" id={noteId}>{fitCta.note}</span>
</div>

<style>
  .fit-cta {
    display: inline-grid;
    justify-items: start;
    gap: var(--space-2);
  }
  .fit-cta__note {
    font-size: var(--fs-xs);
    line-height: 1.3;
    color: var(--ink-3);
  }
</style>
