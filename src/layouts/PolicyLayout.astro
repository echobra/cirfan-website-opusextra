---
// src/layouts/PolicyLayout.astro
// Layout for the Markdown files in src/pages/policies/. Edit policy text in those .md files.
import BaseLayout from './BaseLayout.astro';
import { site, policies, formatDate } from '../config/site';

interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}

const { title, description } = Astro.props.frontmatter;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
---

<BaseLayout title={`${title} | cirfan`} description={description}>
  <section class="page-head">
    <div class="wrap page-head__inner">
      <h1 class="policy-title">{title}</h1>
      <p class="small-print">Last updated {formatDate(site.policiesUpdated)}</p>
    </div>
  </section>

  <section class="section policy">
    <div class="wrap policy__grid">
      <nav class="policy__nav" aria-label="Policies">
        <ul>
          {
            policies.map((p) => (
              <li>
                <a href={p.href} aria-current={p.href === path ? 'page' : undefined}>
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <article class="prose policy__body">
        <slot />
        <h2>Questions</h2>
        <p>
          Write to <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .policy-title {
    max-width: 16ch;
    font-size: var(--fs-3xl) !important;
    line-height: 1.02 !important;
  }
  .policy {
    padding-top: var(--space-8);
  }
  .policy__grid {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr);
    gap: var(--space-7) clamp(2rem, 6vw, 7rem);
    align-items: start;
  }
  .policy__nav {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .policy__nav ul {
    display: grid;
    gap: 0.15rem;
    list-style: none;
    border-left: 1px solid var(--line-strong);
  }
  .policy__nav a {
    display: block;
    padding: 0.4rem 0 0.4rem var(--space-4);
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: var(--fs-sm);
    color: var(--ink-3);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }
  .policy__nav a:hover {
    color: var(--ink);
  }
  .policy__nav a[aria-current='page'] {
    border-left-color: var(--mark);
    color: var(--ink);
    font-weight: 500;
  }
  .policy__body :global(> :first-child) {
    margin-top: 0;
  }
  .policy__body :global(p:first-child) {
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: var(--ink);
  }

  @media (max-width: 52rem) {
    .policy__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .policy__nav {
      position: static;
      order: 2;
      padding-top: var(--space-6);
      border-top: 1px solid var(--line);
    }
  }
</style>
